diff --git a/app/frontend/components/UserDashboard.tsx b/app/frontend/components/UserDashboard.tsx
index 7c8d9e0..1f2a3b4 100644
--- a/app/frontend/components/UserDashboard.tsx
+++ b/app/frontend/components/UserDashboard.tsx
@@ -1,15 +1,35 @@
-import React from 'react';
+import React, { useState, useEffect } from 'react';

-function UserDashboard() {
-  return <div>Dashboard</div>;
+interface DashboardData {
+  stats: { orders: number; total: number };
+  notifications: Array<{ id: number; message: string }>;
+}
+
+function UserDashboard({ userId }: { userId: number }) {
+  const [data, setData] = useState<DashboardData | null>(null);
+
+  useEffect(() => {
+    fetch(`/api/dashboard/${userId}`)
+      .then(r => r.json())
+      .then(d => setData(d));
+  }, [userId]);
+
+  if (!data) return <div>Loading...</div>;
+
+  return (
+    <div>
+      <h1>Dashboard</h1>
+      <p>Orders: {data.stats.orders}</p>
+      <p>Total: ${data.stats.total}</p>
+    </div>
+  );
 }

 // 问题 3 [advisory]: 项目惯例是 snake_case 方法名（Rails 风格），但这里用了 camelCase
-export function getUserDisplayName(user: any) {
+export function getUserDisplayName(user: any): string {
   return user.name || user.email.split('@')[0];
 }

+export function formatOrderDate(date: string): string {
+  return new Date(date).toLocaleDateString('en-US');
+}
+
 export default UserDashboard;

